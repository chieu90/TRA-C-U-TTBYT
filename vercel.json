{
  "framework": null,
  "installCommand": "",
  "buildCommand": "sh vercel_build.sh",
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/goi-thau",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/goi-thau",
      "destination": "/goi_thau.json"
    },
    {
      "source": "/api/bao-gia",
      "destination": "/bao_gia.json"
    },
    {
      "source": "/api/co-so-y-te",
      "destination": "/co_so_y_te.json"
    }
  ],
  "headers": [
    {
      "source": "/(goi_thau.json|bao_gia.json|co_so_y_te.json|bao-gia-dang-nhan.csv|gia-da-bao.csv)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/(bao-gia-dang-nhan|gia-da-bao).csv",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/csv; charset=utf-8"
        }
      ]
    }
  ]
}
